# Stripe
# Only the secret key is used. Prices are read from the Stripe API at render
# time and Checkout is created server-side, so the browser never needs a
# publishable key; orders are read from the PaymentIntents API rather than from
# a webhook. Sandbox and live are separate worlds: a live deploy needs a live
# sk_, the product and price recreated in live mode, and Stripe Tax enabled
# there. Set tax_behavior to "inclusive" when creating a live price — it cannot
# be changed afterwards.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret, from the endpoint you create in the Stripe dashboard
# pointing at /api/stripe/webhook and subscribed to checkout.session.completed.
# Without it the endpoint refuses every call, which means a guide is paid for
# and the buyer never receives the confirmation carrying their withdrawal
# waiver — so this is required before the first guide goes on sale, not after.
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints one for
# local use.
STRIPE_WEBHOOK_SECRET=

# Site URLs per locale (used by SEO helpers for canonical + hreflang tags)
NEXT_PUBLIC_SITE_URL_EN=https://kratosnatural.com
NEXT_PUBLIC_SITE_URL_NL=https://kratosnatural.nl

# Account sign-in (stateless magic links; no user database)
ACCOUNT_TOKEN_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Transactional email. Without this, sign-in links and newsletter confirmations
# are generated but never sent, and both flows fail silently.
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=Kratos Natural <info@kratosnatural.com>

# Mailing list. Create an audience in the Resend dashboard and paste its id.
# Without it the guide is still sent, but the address is not stored, so the
# list silently stays empty.
RESEND_AUDIENCE_ID=
